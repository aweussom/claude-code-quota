#
# statusline.ps1 — Claude Code status line (installed by claude-code-quota)
#
# Output example:
#   Sonnet 4.6 | main │ ctx:42% │ 5h:68% ~1 hr 12 min │ 7d:31% ~4 d 2 hr 5 min
#
# Requires PowerShell 7+: settings.json must launch this with pwsh, not
# powershell.exe, which mis-decodes this file's UTF-8 glyphs.
#
# Edit this file freely. Requires quota-lib.ps1 in %USERPROFILE%\.claude\

#Requires -Version 7.0

# ── Output encoding ───────────────────────────────────────────────────────────
# Claude Code captures stdout through a pipe, where PowerShell defaults to the
# OEM code page — non-ASCII glyphs like ⚠ get substituted with "?".
[Console]::OutputEncoding = [System.Text.Encoding]::UTF8

# ── Read session JSON from stdin ──────────────────────────────────────────────
$sessionRaw = [Console]::In.ReadToEnd()
if ([string]::IsNullOrWhiteSpace($sessionRaw)) { exit 0 }
try   { $session = $sessionRaw | ConvertFrom-Json }
catch { Write-Output "ctx:?%"; exit 0 }

# ── Model + thinking level ────────────────────────────────────────────────────
# Claude Code sends `model` as an object {id, display_name}; older builds sent a
# bare ID string. Prefer display_name -- it is Claude Code's own label and needs
# no family list -- and map the ID only when there is nothing better.
#
# Never let the raw object reach $modelLabel. `-match` on a PSCustomObject
# stringifies it to "@{id=claude-...; display_name=...}", so the regex matched
# by accident for known families, but an unlisted family took the fallback
# branch, assigned the *object*, and `$label += " | $gitBranch"` threw
# op_Addition -- dropping the model AND the branch, with the error on stderr
# where the statusline never shows it.
$modelLabel = ""
$mObj  = $session.model
$mId   = ""
$mName = ""
if ($mObj -is [string]) {
    $mId = $mObj
} elseif ($null -ne $mObj) {
    if ($mObj.PSObject.Properties['display_name']) { $mName = [string]$mObj.display_name }
    if ($mObj.PSObject.Properties['id'])           { $mId   = [string]$mObj.id }
}
if (-not [string]::IsNullOrWhiteSpace($mName)) {
    $modelLabel = $mName
} elseif (-not [string]::IsNullOrWhiteSpace($mId)) {
    # Map model ID → friendly name: claude-sonnet-4-6 → "Sonnet 4.6",
    # claude-opus-5 → "Opus 5".  The minor component is optional because newer
    # IDs omit it, and any trailing date suffix is ignored.
    if ($mId -match 'claude-(opus|sonnet|haiku|fable|mythos)-(\d+)(?:-(\d+))?') {
        $family     = (Get-Culture).TextInfo.ToTitleCase($Matches[1])
        $modelLabel = "$family $($Matches[2])"
        if ($Matches[3]) { $modelLabel += ".$($Matches[3])" }
    } else {
        $modelLabel = $mId  # fallback: raw ID
    }
}
if ($modelLabel -ne "") {
    # Append thinking indicator if budget tokens are set
    if ($session.thinking_budget_tokens -and [int]$session.thinking_budget_tokens -gt 0) {
        $modelLabel += " (thinking)"
    }
}

# ── Git branch ────────────────────────────────────────────────────────────────
$gitBranch = ""
$repoDir = $session.cwd
if (-not [string]::IsNullOrWhiteSpace($repoDir) -and (Test-Path $repoDir -PathType Container)) {
    try {
        $branch = & git -C $repoDir branch --show-current 2>$null
        if (-not [string]::IsNullOrWhiteSpace($branch)) {
            $gitBranch = $branch.Trim()
        }
    } catch {}
}

# ── Context window ────────────────────────────────────────────────────────────
$ctxPct = ""
if ($session.context_window -and $null -ne $session.context_window.used_percentage) {
    $ctxPct = [int][math]::Round([double]$session.context_window.used_percentage)
}

# ── Quota (via quota-lib.ps1) ─────────────────────────────────────────────────
# Start empty so a missing quota-lib.ps1 degrades to model/branch/ctx instead
# of "Cannot index into a null array" on every $QuotaResult read below (each
# read is also [string]-cast: an absent key is $null, and $null -ne "" is
# $true in PowerShell, which would render "5h:%").
$QuotaResult = @{}
$libPath = "$env:USERPROFILE\.claude\quota-lib.ps1"
if (Test-Path $libPath -PathType Leaf) {
    . $libPath
    # 60 s TTL while a session is active (transcript recently written); 5 min while idle
    $ttl = 300
    if ($session.transcript_path -and (Test-Path $session.transcript_path -PathType Leaf)) {
        $tAge = ([DateTimeOffset]::UtcNow -
                 (Get-Item $session.transcript_path -ErrorAction SilentlyContinue).LastWriteTimeUtc).TotalSeconds
        if ($tAge -lt 300) { $ttl = 60 }
    }
    Invoke-QuotaGet -Ttl $ttl
}

# ── ANSI colours (Windows Terminal, VS Code, pwsh 7+) ────────────────────────
if ($env:WT_SESSION -or $env:TERM_PROGRAM -or ($PSVersionTable.PSVersion.Major -ge 7)) {
    $cGreen = "`e[32m"; $cYellow = "`e[33m"; $cRed = "`e[31m"; $cReset = "`e[0m"
} else {
    $cGreen = ""; $cYellow = ""; $cRed = ""; $cReset = ""
}

# ── Assemble parts ────────────────────────────────────────────────────────────
$parts = [System.Collections.Generic.List[string]]::new()

if ($modelLabel -ne "") {
    $label = $modelLabel
    if ($gitBranch -ne "") { $label += " | $gitBranch" }
    $parts.Add($label)
} elseif ($gitBranch -ne "") {
    $parts.Add($gitBranch)
}

if ($ctxPct -ne "") {
    $parts.Add("ctx:${ctxPct}%")
}

$qpct     = [string]$QuotaResult['pct']
$resetsIn = [string]$QuotaResult['resets_in']
$isStale  = $QuotaResult['stale'] -eq 'true'
$qerr     = [string]$QuotaResult['error']
if ($qpct -ne "") {
    $n     = [double]$qpct
    $color = if ($n -gt 75) { $cRed } elseif ($n -gt 50) { $cYellow } else { $cGreen }
    $label = "${qpct}%"
    if ($isStale)  { $label += "⚠" }   # ⚠ = last fetch failed, showing older data (run /quota for details)
    if ($resetsIn) { $label += " ~$resetsIn" }
    $parts.Add("${color}5h:${label}${cReset}")
} elseif ($QuotaResult['pct_unknown'] -eq 'true') {
    # The window rolled over while fetches were failing, so the last figure we
    # hold describes a spent window.  Say we don't know rather than print it —
    # and don't drop the segment, which would read as "no limit".  Checked before
    # the generic error below: we still know the bucket exists and when it reset,
    # which is more useful than the fetch error that stopped us updating it.
    $parts.Add("${cYellow}5h:?⚠${cReset}")
} elseif ($qerr -ne "") {
    # No quota data at all — say why instead of silently showing nothing
    $parts.Add("${cRed}quota: $qerr${cReset}")
}

$wpct    = [string]$QuotaResult['weekly_pct']
$wresets = [string]$QuotaResult['weekly_resets_in']
if ($wpct -ne "") {
    $label = "${wpct}%"
    if ($wresets) { $label += " ~$wresets" }
    $parts.Add("7d:$label")
} elseif ($QuotaResult['weekly_pct_unknown'] -eq 'true') {
    $parts.Add("${cYellow}7d:?⚠${cReset}")
}

# Model/surface-scoped limit (e.g. a per-model weekly cap) — a separate
# allowance from 5h/7d, so it gets its own segment rather than replacing one.
# Absent for accounts with no scoped limits, so this normally prints nothing.
$sworst  = [string]$QuotaResult['scoped_worst']
$spct    = [string]$QuotaResult['scoped_worst_pct']
$sresets = [string]$QuotaResult['scoped_worst_resets_in']
if ($sworst -ne "" -and $spct -ne "") {
    $n     = [double]$spct
    $color = if ($n -gt 75) { $cRed } elseif ($n -gt 50) { $cYellow } else { $cGreen }
    $label = "${spct}%"
    if ($QuotaResult['scoped_alert'] -eq 'true') { $label += "⚠" }
    if ($sresets) { $label += " ~$sresets" }   # only set when it differs from 7d
    $parts.Add("${color}${sworst}:${label}${cReset}")
}

Write-Output ($parts -join " | ")
